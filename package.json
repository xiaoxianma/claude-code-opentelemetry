{
  "name": "claude-code-opentelemetry",
  "version": "1.0.0",
  "description": "Claude Code-compatible OpenTelemetry metrics for Pi, ready for Grafana dashboard 25255",
  "type": "module",
  "license": "MIT",
  "author": "xiaoxianma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxianma/claude-code-opentelemetry.git"
  },
  "bugs": {
    "url": "https://github.com/xiaoxianma/claude-code-opentelemetry/issues"
  },
  "homepage": "https://github.com/xiaoxianma/claude-code-opentelemetry#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "claude-code",
    "opentelemetry",
    "otel",
    "grafana",
    "prometheus",
    "observability",
    "metrics"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "core.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx --test core.test.ts",
    "typecheck": "tsc",
    "check": "npm test && npm run typecheck",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "diff": "8.0.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@types/node": "24.10.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.81.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
