{
  "name": "claude-code-opentelemetry",
  "version": "1.1.0",
  "description": "Bring pi into your Claude Code observability stack—same OTLP pipeline, same metrics, same Grafana dashboard.",
  "type": "module",
  "license": "MIT",
  "author": "xiaoxianma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxianma/claude-code-opentelemetry.git"
  },
  "bugs": {
    "url": "https://github.com/xiaoxianma/claude-code-opentelemetry/issues"
  },
  "homepage": "https://github.com/xiaoxianma/claude-code-opentelemetry#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "claude-code",
    "opentelemetry",
    "otel",
    "grafana",
    "prometheus",
    "observability",
    "metrics"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "diff": "8.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/xiaoxianma/claude-code-opentelemetry/main/media/hero.png"
  }
}
